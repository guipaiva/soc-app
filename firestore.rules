rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function papel() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel;
    }

    match /incidentes/{id} {
      allow read: if request.auth != null && papel() in ['analista', 'operador', 'admin'];
      allow create: if request.auth != null && papel() in ['operador', 'admin'];
      allow update: if request.auth != null && papel() in ['analista', 'admin'];
      allow delete: if request.auth != null && papel() == 'admin';
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
  }
}
